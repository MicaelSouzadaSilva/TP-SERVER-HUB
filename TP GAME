-- =========================================================
-- Helpers de UI
-- =========================================================
local function addCorner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, r or 16)
    c.Parent = obj
    return c
end

local function addStroke(obj, color, thickness, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or COR.neonCiano
    s.Thickness = thickness or 1.5
    s.Transparency = transparency or 0
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    return s
end

-- Gradiente neon (aplicado em strokes/labels)
local function addGradient(obj, c1, c2, c3, rotation)
    local g = Instance.new("UIGradient")
    g.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, c1),
        ColorSequenceKeypoint.new(0.5, c2 or c1),
        ColorSequenceKeypoint.new(1, c3 or c2 or c1),
    })
    g.Rotation = rotation or 45
    g.Parent = obj
    return g
end

-- Sombra realista (Frame escuro com blur via gradient)
local function addShadow(parent, size, pos, corner)
    local sh = Instance.new("Frame")
    sh.Size = size
    sh.Position = pos
    sh.BackgroundColor3 = Color3.new(0, 0, 0)
    sh.BackgroundTransparency = 0.35
    sh.BorderSizePixel = 0
    sh.ZIndex = parent.ZIndex - 1
    sh.Parent = parent
    addCorner(sh, corner or 20)
    -- gradiente pra "suavizar" as bordas da sombra
    local g = Instance.new("UIGradient")
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.5, 0.7),
        NumberSequenceKeypoint.new(1, 1),
    })
    g.Rotation = 90
    g.Parent = sh
    return sh
end

-- Reflexo de vidro (highlight superior)
local function addGlassHighlight(parent)
    local hl = Instance.new("Frame")
    hl.Name = "GlassHighlight"
    hl.Size = UDim2.new(1, -8, 0, 40)
    hl.Position = UDim2.new(0, 4, 0, 4)
    hl.BackgroundColor3 = Color3.new(1, 1, 1)
    hl.BackgroundTransparency = 0.85
    hl.BorderSizePixel = 0
    hl.ZIndex = parent.ZIndex + 1
    hl.Parent = parent
    addCorner(hl, 14)
    local g = Instance.new("UIGradient")
    g.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.7),
        NumberSequenceKeypoint.new(1, 1),
    })
    g.Rotation = 90
    g.Parent = hl
    return hl
end

-- "Glow" pulsante no stroke
local function pulseStroke(stroke, c1, c2, speed)
    local t = 0
    local conn = RunService.Heartbeat:Connect(function(dt)
        t = t + dt * (speed or 1)
        local lerp = (math.sin(t) + 1) / 2
        stroke.Color = c1:Lerp(c2, lerp)
        stroke.Transparency = 0.2 + lerp * 0.5
    end)
    table.insert(conexoes, conn)
    return conn
end

-- Botão neon padrão
local function makeNeonButton(parent, txt, size, pos, baseColor, glowColor)
    local btn = Instance.new("TextButton")
    btn.Size = size
    btn.Position = pos
    btn.BackgroundColor3 = COR.fundoGlass
    btn.BackgroundTransparency = 0.15
    btn.BorderSizePixel = 0
    btn.Text = txt
    btn.TextColor3 = COR.texto
    btn.TextScaled = true
    btn.Font = Enum.Font.GothamBold
    btn.AutoButtonColor = false
    btn.Parent = parent
    addCorner(btn, 12)

    -- gradient interno sutil
    local bg = Instance.new("UIGradient")
    bg.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, baseColor),
        ColorSequenceKeypoint.new(1, COR.fundoGlass),
    })
    bg.Transparency = NumberSequence.new(0.55)
    bg.Rotation = 45
    bg.Parent = btn

    -- stroke neon
    local stroke = addStroke(btn, glowColor, 2, 0.15)
    addGradient(stroke, glowColor, baseColor, glowColor, 45)
    pulseStroke(stroke, glowColor, baseColor, 1.5)

    -- reflexo
    local hl = Instance.new("Frame")
    hl.Size = UDim2.new(1, -6, 0, 14)
    hl.Position = UDim2.new(0, 3, 0, 3)
    hl.BackgroundColor3 = Color3.new(1, 1, 1)
    hl.BackgroundTransparency = 0.88
    hl.BorderSizePixel = 0
    hl.ZIndex = btn.ZIndex + 1
    hl.Parent = btn
    addCorner(hl, 8)

    -- hover / click
    btn.MouseEnter:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 0}):Play()
        TweenService:Create(btn, TweenInfo.new(0.25), {BackgroundTransparency = 0}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(stroke, TweenInfo.new(0.25), {Transparency = 0.15}):Play()
        TweenService:Create(btn, TweenInfo.new(0.25), {BackgroundTransparency = 0.15}):Play()
    end)
    btn.MouseButton1Down:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.1), {
            Size = UDim2.new(size.X.Scale, size.X.Offset - 4, size.Y.Scale, size.Y.Offset - 4)
        }):Play()
    end)
    btn.MouseButton1Up:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.15), {
            Size = UDim2.new(size.X.Scale, size.X.Offset, size.Y.Scale, size.Y.Offset)
        }):Play()
    end)

    return btn, stroke
end

