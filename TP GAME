    -- ================= BOTÃO COPIAR =================
    local BotaoCopiar = makeNeonButton(
        Frame,
        "📋  COPIAR JOBID ATUAL",
        UDim2.new(1, -32, 0, 38),
        UDim2.new(0, 16, 0, 162),
        COR.neonRosa,
        COR.neonCiano
    )
    BotaoCopiar.ZIndex = Frame.ZIndex + 2

    -- ================= STATUS =================
    local StatusBg = Instance.new("Frame")
    StatusBg.Size = UDim2.new(1, -32, 0, 34)
    StatusBg.Position = UDim2.new(0, 16, 0, 208)
    StatusBg.BackgroundColor3 = Color3.fromRGB(8, 10, 18)
    StatusBg.BackgroundTransparency = 0.35
    StatusBg.BorderSizePixel = 0
    StatusBg.ZIndex = Frame.ZIndex + 2
    StatusBg.Parent = Frame
    addCorner(StatusBg, 10)
    local sStroke = addStroke(StatusBg, COR.neonVerde, 1, 0.4)
    addGradient(sStroke, COR.neonVerde, COR.neonCiano, COR.neonVerde, 0)

    local Status = Instance.new("TextLabel")
    Status.Size = UDim2.new(1, -16, 1, 0)
    Status.Position = UDim2.new(0, 8, 0, 0)
    Status.BackgroundTransparency = 1
    Status.Text = "SISTEMA PRONTO"
    Status.TextColor3 = COR.neonVerde
    Status.TextScaled = true
    Status.Font = Enum.Font.GothamBold
    Status.TextXAlignment = Enum.TextXAlignment.Left
    Status.ZIndex = StatusBg.ZIndex + 1
    Status.Parent = StatusBg

    local function setStatus(txt, cor)
        Status.Text = txt
        Status.TextColor3 = cor or COR.neonVerde
        TweenService:Create(sStroke, TweenInfo.new(0.3), {Color = cor or COR.neonVerde}):Play()
    end

    -- ================= LÓGICA =================
    local lastCopy = 0
    local function resetBtnText(btn, txt, delay)
        task.delay(delay, function()
            if btn.Parent then btn.Text = txt end
        end)
    end

    local function ConectarServidor(jobId)
        jobId = (jobId or ""):gsub("%s", ""):gsub("%-", "")
        if jobId == "" then
            setStatus("❌  COLE UM JOBID VÁLIDO", COR.neonVermelho)
            return
        end

        setStatus("🔄  CONECTANDO...", COR.neonAmarelo)

        local conn
        conn = TeleportService.TeleportInitFailed:Connect(function(_, result)
            setStatus("❌  FALHA: " .. tostring(result):upper(), COR.neonVermelho)
            if conn then conn:Disconnect() end
        end)

        local ok, err = pcall(function()
            local opts = Instance.new("TeleportOptions")
            TeleportService:TeleportToPlaceInstance(game.PlaceId, jobId, Player, opts)
        end)

        if ok then
            setStatus("✅  TELEPORT INICIADO", COR.neonVerde)
        else
            setStatus("❌  ERRO: " .. tostring(err):upper(), COR.neonVermelho)
            if conn then conn:Disconnect() end
        end
    end

    BotaoConectar.MouseButton1Click:Connect(function()
        ConectarServidor(CaixaTexto.Text)
    end)

    BotaoCopiar.MouseButton1Click:Connect(function()
        if os.clock() - lastCopy < 1.6 then return end
        lastCopy = os.clock()

        if setclipboard then
            pcall(setclipboard, game.JobId)
            BotaoCopiar.Text = "✅  COPIADO!"
            setStatus("📋  " .. game.JobId, COR.neonCiano)
        else
            BotaoCopiar.Text = "❌  SEM SUPORTE"
            setStatus("❌  EXECUTOR SEM CLIPBOARD", COR.neonVermelho)
        end
        resetBtnText(BotaoCopiar, "📋  COPIAR JOBID ATUAL", 1.5)
    end)

    CaixaTexto.FocusLost:Connect(function(enter)
        if enter then ConectarServidor(CaixaTexto.Text) end
    end)

    -- ================= DRAG =================
    local dStart, dPos
    Frame.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1
        or i.UserInputType == Enum.UserInputType.Touch then
            dStart = i.Position
            dPos = Frame.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if dStart and (i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseMovement) then
            local d = i.Position - dStart
            Frame.Position = UDim2.new(
                dPos.X.Scale, dPos.X.Offset + d.X,
                dPos.Y.Scale, dPos.Y.Offset + d.Y
            )
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.Touch
        or i.UserInputType == Enum.UserInputType.MouseButton1 then
            dStart = nil
        end
    end)

    FecharBtn.MouseButton1Click:Connect(function()
        if getgenv()._jobidDesativar then getgenv()._jobidDesativar() end
    end)

    return ScreenGui
end

